# =====================================================================
# ArbiGold — .gitignore (monorepo: backend + frontend + shared packages)
# Stack aún no congelado: cubre Node/TS y Python.
# =====================================================================

# ---------- Secretos y entorno (NUNCA versionar) ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials*.json
service-account*.json

# ---------- Documentos KYC / datos sensibles locales ----------
# Los expedientes reales viven en storage cifrado, jamás en el repo.
uploads/
storage/
kyc_docs/
data/private/
*.sqlite
*.sqlite3
*.db
dumps/
*.dump
*.sql.gz
backups/

# ---------- Excel / exports operativos (datos reales de negocio) ----------
*.xlsx
*.xls
*.xlsm
*.csv
!**/fixtures/**/*.csv
!**/seeds/**/*.csv

# ---------- Node / TypeScript ----------
node_modules/
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.turbo/
.nx/

# ---------- Builds frontend ----------
dist/
build/
out/
.next/
.vite/
.cache/
.parcel-cache/
storybook-static/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ---------- Tests / cobertura ----------
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output/
.pytest_cache/
junit*.xml
test-results/
playwright-report/

# ---------- Logs ----------
logs/
*.log

# ---------- IDE / SO ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# ---------- Docker / infra local ----------
docker-compose.override.yml
.docker-data/
*.tfstate
*.tfstate.*
.terraform/

# ---------- Agentes / herramientas IA (estado local, no compartido) ----------
.claude/settings.local.json
.cursor/
.worktrees/
memory/notes/*.local.md
