# ─────────────────────────────────────────────────────────────────────────────
# ArbiGold — frontend (apps/frontend)
# Copia este archivo a apps/frontend/.env.local (local) o configúralas en tu hosting.
# Guía completa: docs/setup/arranque.md
#
# ⚠ Todo lo que empieza con VITE_ se INCRUSTA en el JavaScript que descarga el
#   navegador: aquí solo van valores PÚBLICOS. Ningún secreto, nunca.
# ─────────────────────────────────────────────────────────────────────────────

# URL base de la API. Local: http://localhost:3000. Producción: https://api.tudominio.com
VITE_API_URL=http://localhost:3000

# Supabase Auth (login y MFA desde el navegador). Los DATOS van SIEMPRE por la API:
# el cliente de supabase-js NO se usa para consultar tablas (supabase.from(...) prohibido).
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Clave PÚBLICA (sb_publishable_…). Es segura en el navegador porque RLS deniega todo
# acceso directo a las tablas.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<…>
